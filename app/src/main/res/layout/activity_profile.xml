<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1110">

    <ScrollView
        android:id="@+id/profileScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="110dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile" android:textColor="#F2F3F8" android:textSize="32sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Your fitness journey, all in one place" android:textColor="#A6AAB6" android:textSize="14sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editProfileButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="#62E89B"
                    android:textStyle="bold"
                    android:backgroundTint="#15231D"
                    app:cornerRadius="23dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#111A18"
                app:cardCornerRadius="28dp"
                app:strokeColor="#25332F"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:id="@+id/avatarText" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:background="@drawable/bg_profile_avatar" android:textColor="#0B1110" android:textSize="24sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                            <TextView android:id="@+id/nameText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F2F3F8" android:textSize="21sp" android:textStyle="bold" />
                            <TextView android:id="@+id/emailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#A6AAB6" android:textSize="13sp" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_member_badge" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp" android:text="MEMBER" android:textColor="#62E89B" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:weightSum="4">
                        <include layout="@layout/item_profile_stat" android:id="@+id/statAge" />
                        <include layout="@layout/item_profile_stat" android:id="@+id/statHeight" />
                        <include layout="@layout/item_profile_stat" android:id="@+id/statCurrent" />
                        <include layout="@layout/item_profile_stat" android:id="@+id/statTarget" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#111A18"
                app:cardCornerRadius="28dp"
                app:strokeColor="#25332F"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Weight Progress" android:textColor="#F2F3F8" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/weightDirectionText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#62E89B" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <com.musclesOS.adil.utils.customView.WeightProgressArcView
                        android:id="@+id/weightProgressArc"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_marginTop="2dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:weightSum="2">
                        <TextView android:id="@+id/currentWeightLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:textColor="#A6AAB6" android:textSize="13sp" />
                        <TextView android:id="@+id/targetWeightLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="#A6AAB6" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="My Goals" android:textColor="#F2F3F8" android:textSize="19sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/goalsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Focus Areas" android:textColor="#F2F3F8" android:textSize="19sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/focusContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#111A18"
                app:cardCornerRadius="24dp"
                app:strokeColor="#25332F"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Training Profile" android:textColor="#F2F3F8" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/activityText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#A6AAB6" android:textSize="14sp" />
                    <TextView android:id="@+id/experienceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#A6AAB6" android:textSize="14sp" />
                    <TextView android:id="@+id/customGoalText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#A6AAB6" android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#291518"
                android:text="Log Out"
                android:textAllCaps="false"
                android:textColor="#FF6B6B"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
