<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".ui.auth.LoginActivity">

    <FrameLayout
        android:id="@+id/heroFrame"
        android:layout_width="0dp"
        android:layout_height="276dp"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivHeroMachine"
            android:layout_width="match_parent"
            android:layout_height="296dp"
            android:layout_gravity="center"

            android:contentDescription="@string/app_logo"
            android:scaleType="fitXY"
            android:src="@drawable/figma_login_machine" />

        <View
            android:id="@+id/heroFade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_fade_to_white" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/ivLogo"
        android:layout_width="63dp"
        android:layout_height="63dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_figma_logo_badge"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:contentDescription="@string/app_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/figma_logo_mark" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvHeadline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/work_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/sign_in_headline"
        android:textColor="@color/text_main"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo" />

    <TextView
        android:id="@+id/tvSubheadline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/work_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.6"
        android:text="@string/subheadline_personalize"
        android:textColor="@color/text_sub"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeadline" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubheadline"
        app:layout_constraintWidth_max="343dp"
        app:layout_constraintWidth_percent="0.914">

        <TextView
            android:id="@+id/tvEmailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/work_sans"
            android:includeFontPadding="false"
            android:text="@string/label_email"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/emailField"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_figma_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmailLabel">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/label_email"
                android:src="@drawable/ic_email_outline"
                app:tint="@color/text_main" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autofillHints="emailAddress"
                android:background="@null"
                android:fontFamily="@font/work_sans"
                android:hint="@string/enter_your_email"
                android:includeFontPadding="false"
                android:inputType="textEmailAddress"
                android:padding="0dp"
                android:singleLine="true"
                android:textCursorDrawable="@drawable/bg_cursor_orange"
                android:textColor="@color/text_field"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPasswordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/work_sans"
            android:includeFontPadding="false"
            android:text="@string/label_password"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/emailField" />

        <LinearLayout
            android:id="@+id/passwordField"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_figma_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/label_password"
                android:src="@drawable/ic_lock_outline"
                app:tint="@color/text_main" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autofillHints="password"
                android:background="@null"
                android:fontFamily="@font/work_sans"
                android:hint="@string/enter_your_password"
                android:includeFontPadding="false"
                android:inputType="textPassword"
                android:padding="0dp"
                android:singleLine="true"
                android:textCursorDrawable="@drawable/bg_cursor_orange"
                android:textColor="@color/text_field"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp"
                />

            <ImageView
                android:id="@+id/ivPasswordToggle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/enter_your_password"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_eye"
                app:tint="@color/text_main" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmailLogin"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_figma_primary"
            android:fontFamily="@font/work_sans"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/sign_in"
            android:textAllCaps="false"
            android:textColor="@color/btn_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="19dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="textEnd"
            app:iconPadding="12dp"
            app:iconTint="@color/btn_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/passwordField" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/socialRow"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardForm">

        <ImageButton
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_figma_social"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_google" />

        <ImageButton
            android:id="@+id/btnFacebookLogin"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_figma_social"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_facebook"
            app:tint="#0088FD" />



    </LinearLayout>

    <LinearLayout
        android:id="@+id/accountPrompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/socialRow">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/work_sans"
            android:includeFontPadding="false"
            android:text="@string/dont_have_account"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/registerscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/work_sans"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackground"
            android:text="@string/sign_up_underlined"
            android:textColor="@color/orange_primary"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/work_sans"
        android:includeFontPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/forgot_password_underlined"
        android:textColor="@color/orange_primary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/accountPrompt" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuestLogin"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_figma_primary"
        android:fontFamily="@font/work_sans"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/continue_as_guest"
        android:textAllCaps="false"
        android:textColor="@color/btn_text"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="19dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvForgotPassword" />


    <View
        android:id="@+id/loadingScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/loadingAnimation"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="loading.json"
        app:lottie_loop="true" />

</androidx.constraintlayout.widget.ConstraintLayout>
