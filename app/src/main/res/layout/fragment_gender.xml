<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_main" android:paddingStart="16dp" android:paddingEnd="16dp">
    <ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="60dp" android:background="@drawable/bg_onboarding_choice" android:contentDescription="Back" android:src="@android:drawable/ic_media_previous" app:tint="@color/text_sub" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <TextView android:id="@+id/assessmentTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="@font/work_sans" android:text="Assessment" android:textColor="@color/text_main" android:textSize="20sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@id/backButton" app:layout_constraintStart_toEndOf="@id/backButton" app:layout_constraintTop_toTopOf="@id/backButton"/>
    <TextView android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/bg_onboarding_tag" android:gravity="center" android:paddingHorizontal="12dp" android:text="1 of 5" android:textColor="#2563EB" android:textSize="14sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@id/backButton" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/backButton"/>
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:fontFamily="@font/work_sans" android:gravity="center" android:text="What is your gender?" android:textColor="@color/text_main" android:textSize="30sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/backButton"/>
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardMale" android:layout_width="0dp" android:layout_height="144dp" android:layout_marginTop="48dp" app:cardBackgroundColor="@color/field_bg" app:cardCornerRadius="32dp" app:cardElevation="0dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/title">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.85" android:contentDescription="Male" android:scaleType="centerCrop" android:src="@drawable/onboarding_male"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="16dp" android:fontFamily="@font/work_sans" android:text="♂  Male" android:textColor="@color/text_main" android:textSize="16sp" android:textStyle="bold"/><TextView android:id="@+id/maleCheck" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="bottom|start" android:layout_margin="16dp" android:background="@drawable/bg_onboarding_choice" android:gravity="center" android:text="✓" android:textColor="@color/orange_primary" android:visibility="gone"/></FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardFemale" android:layout_width="0dp" android:layout_height="144dp" android:layout_marginTop="8dp" app:cardBackgroundColor="@color/field_bg" app:cardCornerRadius="32dp" app:cardElevation="0dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/cardMale">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.85" android:contentDescription="Female" android:scaleType="centerCrop" android:src="@drawable/onboarding_female"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="16dp" android:fontFamily="@font/work_sans" android:text="♀  Female" android:textColor="@color/text_main" android:textSize="16sp" android:textStyle="bold"/><TextView android:id="@+id/femaleCheck" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="bottom|start" android:layout_margin="16dp" android:background="@drawable/bg_onboarding_choice" android:gravity="center" android:text="✓" android:textColor="@color/orange_primary" android:visibility="gone"/></FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:id="@+id/skipButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginTop="48dp" android:background="@drawable/bg_onboarding_skip" android:gravity="center" android:text="Prefer to skip, thanks!   ×" android:textColor="@color/orange_primary" android:textSize="16sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/cardFemale"/>
    <TextView android:id="@+id/button3" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginBottom="34dp" android:background="@drawable/bg_onboarding_button" android:gravity="center" android:text="Continue   →" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
