<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <include
        android:id="@+id/header"
        layout="@layout/onboarding_measurement_header" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/work_sans"
        android:gravity="center"
        android:text="WHAT'S YOUR FOCUS AREA?"
        android:textColor="@color/text_main"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnSplit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.58" />

    <!-- Photo column on the left - Filling entire left height -->
    <FrameLayout
        android:id="@+id/bodyImageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/columnSplit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title">

        <ImageView
            android:id="@+id/bodyImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:paddingEnd="10dp"
            android:src="@drawable/body_image"
            tools:src="@drawable/body_image" />

        <com.musclesOS.adil.ui.onboarding.BodyFocusOverlayView
            android:id="@+id/bodyFocusOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Checklist column on the right - Centered vertically -->
    <ScrollView
        android:id="@+id/optionsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/button3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/columnSplit"
        app:layout_constraintTop_toTopOf="@id/bodyImageContainer"
        app:layout_constraintVertical_bias="0.3">

        <LinearLayout
            android:id="@+id/optionsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- On top of everything, draws the animated dashed lines -->
    <com.musclesOS.adil.ui.onboarding.CalloutOverlayView
        android:id="@+id/calloutOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/button3"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="34dp"
        android:background="@drawable/bg_onboarding_button"
        android:gravity="center"
        android:text="Next   →"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
