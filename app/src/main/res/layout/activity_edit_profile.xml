<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_figma_field"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="‹"
                    android:textColor="@color/text_main"
                    android:textSize="28sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="19dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/work_sans"
                        android:includeFontPadding="false"
                        android:text="Edit Profile"
                        android:textColor="@color/text_main"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/work_sans"
                        android:includeFontPadding="false"
                        android:text="Keep your details up to date"
                        android:textColor="@color/text_hint"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/ProfileEditEyebrow"
                android:layout_marginTop="34dp"
                android:text="PERSONAL DETAILS" />

            <TextView
                style="@style/ProfileEditSectionTitle"
                android:text="The basics" />

            <TextView style="@style/ProfileEditLabel" android:text="Full name" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameInput"
                style="@style/ProfileEditField"
                android:hint="Enter your name"
                android:inputType="textPersonName" />

            <TextView style="@style/ProfileEditLabel" android:text="Email" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailInput"
                style="@style/ProfileEditField"
                android:enabled="false"
                android:textColor="@color/text_hint" />

            <TextView style="@style/ProfileEditLabel" android:text="Age" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ageInput"
                style="@style/ProfileEditField"
                android:inputType="number" />

            <TextView style="@style/ProfileEditLabel" android:text="Gender" />
            <AutoCompleteTextView
                android:id="@+id/genderInput"
                style="@style/ProfileEditField"
                android:dropDownVerticalOffset="4dp"
                android:inputType="none" />

            <TextView
                style="@style/ProfileEditEyebrow"
                android:text="BODY MEASUREMENTS" />

            <TextView
                style="@style/ProfileEditSectionTitle"
                android:text="Your current baseline" />

            <TextView style="@style/ProfileEditLabel" android:text="Height (cm)" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/heightInput"
                style="@style/ProfileEditField"
                android:inputType="number" />

            <TextView style="@style/ProfileEditLabel" android:text="Current weight (kg)" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/currentWeightInput"
                style="@style/ProfileEditField"
                android:inputType="numberDecimal" />

            <TextView style="@style/ProfileEditLabel" android:text="Target weight (kg)" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/targetWeightInput"
                style="@style/ProfileEditField"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/ProfileEditEyebrow"
                android:text="TRAINING PREFERENCES" />

            <TextView
                style="@style/ProfileEditSectionTitle"
                android:text="What you are working towards" />

            <TextView style="@style/ProfileEditLabel" android:text="Activity level" />
            <AutoCompleteTextView
                android:id="@+id/activityInput"
                style="@style/ProfileEditField"
                android:inputType="none" />

            <TextView style="@style/ProfileEditLabel" android:text="Training experience" />
            <AutoCompleteTextView
                android:id="@+id/experienceInput"
                style="@style/ProfileEditField"
                android:inputType="none" />

            <TextView style="@style/ProfileEditLabel" android:text="Goals" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/goalsInput"
                style="@style/ProfileEditField"
                android:hint="Separate goals with commas"
                android:inputType="textCapSentences" />

            <TextView style="@style/ProfileEditLabel" android:text="Focus areas" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/focusInput"
                style="@style/ProfileEditField"
                android:hint="Separate areas with commas"
                android:inputType="textCapSentences" />

            <TextView style="@style/ProfileEditLabel" android:text="Custom goal" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/customGoalInput"
                style="@style/ProfileEditField"
                android:layout_height="104dp"
                android:gravity="top"
                android:hint="Add a personal note or goal"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingTop="16dp"
                android:singleLine="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_figma_primary"
                android:fontFamily="@font/work_sans"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Save changes"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@null"
                android:fontFamily="@font/work_sans"
                android:text="Log out"
                android:textAllCaps="false"
                android:textColor="@color/text_hint"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
