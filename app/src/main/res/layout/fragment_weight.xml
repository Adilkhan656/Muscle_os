<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:paddingHorizontal="16dp">

    <include
        android:id="@+id/header"
        layout="@layout/onboarding_measurement_header" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        android:gravity="center"
        android:text="What’s your weight?"
        android:textColor="@color/text_main"
        android:textSize="31sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="To help track your progress accurately"
        android:textColor="@color/text_hint"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <RadioGroup
        android:id="@+id/unitGroup"
        android:layout_width="220dp"
        android:layout_height="44dp"
        android:layout_marginTop="42dp"
        android:background="@drawable/bg_measurement_toggle"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitle">

        <RadioButton
            android:id="@+id/kg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_measurement_toggle_selected"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:text="kg"
            android:textColor="@color/text_main"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/lbs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:button="@null"
            android:gravity="center"
            android:text="lbs"
            android:textColor="@color/text_main"
            android:textSize="18sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/weightValue"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <com.musclesOS.adil.customView.WeightArcScaleView
        android:id="@+id/weightScale"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="46dp"
        app:layout_constraintBottom_toTopOf="@id/button3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unitGroup" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/button3"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginBottom="34dp"
        android:background="@drawable/bg_onboarding_button"
        android:gravity="center"
        android:text="Next   →"
        android:textColor="@color/btn_text"
        android:textSize="19sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
