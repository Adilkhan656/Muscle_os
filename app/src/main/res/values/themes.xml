<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MuscleOS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/orange_vibrant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/orange_primary</item>
        <item name="android:colorAccent">@color/orange_primary</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="colorSurface">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/text_main</item>

        <item name="colorSecondary">@color/orange_vibrant</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorTertiary">@color/orange_vibrant</item>

        <item name="colorControlActivated">@color/orange_primary</item>
        <item name="android:textColorHighlight">#33F97316</item>
    </style>

    <style name="Theme.MuscleOS" parent="Base.Theme.MuscleOS" />

    <style name="Theme.MuscleOS.Starting" parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/bg_main</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/figma_logo_mark</item>

        <item name="postSplashScreenTheme">@style/Theme.MuscleOS</item>

    </style>

    <style name="Theme.MuscleOS.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/orange_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/muscle_os</item>
        <item name="postSplashScreenTheme">@style/Theme.Splash</item>
    </style>

    <style name="Theme.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="Theme.Welcome" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>
</resources>
